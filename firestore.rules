rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return request.auth != null && profile().active == true &&
        profile().role in ['admin', 'staff'];
    }
    function admin() { return active() && profile().role == 'admin'; }
    function ownStaff(id) {
      return active() && profile().role == 'staff' && profile().staffId == id;
    }
    function validStaff(version, id) {
      return get(/databases/$(database)/documents/catalogs/$(version)).data.ready == true &&
        get(/databases/$(database)/documents/catalogs/$(version)/staff/$(id)).data.active == true;
    }
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    match /settings/schedules {
      allow get: if active();
      allow list, write: if false;
    }
    match /staffAvailability/{date}/staff/{staffId} {
      allow get: if admin() || ownStaff(staffId);
      allow list: if admin();
      allow write: if false;
      match /commits/{requestId} {
        allow get: if admin();
        allow list, write: if false;
      }
    }
    match /catalogs/{version} {
      allow get: if active();
      allow list, write: if false;
      match /staff/{id} {
        allow get: if admin() || ownStaff(id);
        allow list: if admin();
        allow write: if false;
      }
      match /{collection}/{id} {
        allow read: if admin() && collection in ['vehicles', 'passengers', 'baseRoutes'];
        allow write: if false;
      }
    }
    match /schedules/{scheduleId} {
      allow read: if admin();
      // All clients, including admins, publish through confirmSchedule only.
      allow write: if false;
      match /commits/{requestId} {
        allow get: if admin();
        allow list, write: if false;
      }
    }
    match /staffSchedules/{staffId}/days/{scheduleId} {
      allow get: if admin() || (ownStaff(staffId) &&
        validStaff(get(/databases/$(database)/documents/settings/schedules).data.catalogVersion, staffId) &&
        (!exists(/databases/$(database)/documents/staffSchedules/$(staffId)/days/$(scheduleId)) ||
          (resource.data.staffId == staffId && resource.data.status == 'confirmed')));
      allow list: if admin();
      allow write: if false;
    }
    // Demo-only immutable work photos; no client can edit or delete records.
    match /attendance/{staffId}/records/{recordId} {
      function assigned(data) {
        let schedule = get(/databases/$(database)/documents/staffSchedules/$(staffId)/days/$(data.date + '_' + data.period)).data;
        return schedule.status == 'confirmed' && schedule.staffId == staffId &&
          schedule.date == data.date && schedule.period == data.period &&
          schedule.routes.size() == 1 && schedule.routes[0].baseRouteId == data.routeId &&
          validStaff(schedule.catalogVersion, staffId) &&
          (!exists(/databases/$(database)/documents/staffAvailability/$(data.date)/staff/$(staffId)) ||
            !(data.period in get(/databases/$(database)/documents/staffAvailability/$(data.date)/staff/$(staffId)).data.unavailablePeriods));
      }
      allow read: if admin() || ownStaff(staffId);
      allow create: if ownStaff(staffId) && request.auth.token.aud.matches('^demo-.*$') &&
        request.resource.data.keys().hasAll(['staffId', 'uid', 'date', 'period', 'routeId', 'kind', 'registeredAt', 'photo', 'contentType']) &&
        request.resource.data.keys().hasOnly(['staffId', 'uid', 'date', 'period', 'routeId', 'kind', 'registeredAt', 'photo', 'contentType']) &&
        request.resource.data.staffId == staffId && request.resource.data.uid == request.auth.uid &&
        request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.period in ['morning', 'afternoon'] &&
        request.resource.data.routeId is string && request.resource.data.routeId.matches('^[A-Za-z0-9_-]{1,80}$') &&
        ((request.resource.data.period == 'morning' && request.resource.data.kind == 'start') ||
          (request.resource.data.period == 'afternoon' && request.resource.data.kind == 'end')) &&
        recordId == request.resource.data.date + '_' + request.resource.data.period + '_' + request.resource.data.routeId + '_' + request.resource.data.kind &&
        request.resource.data.registeredAt == request.time && request.resource.data.contentType == 'image/jpeg' &&
        request.resource.data.photo is bytes && request.resource.data.photo.size() > 0 && request.resource.data.photo.size() <= 184320 &&
        assigned(request.resource.data);
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
